# ==========================================
# 1. ENVIRONMENT VARIABLES & SECRETS
# ==========================================
# NEVER push these files to GitHub. They contain sensitive keys (API keys, DB passwords, etc.)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Authentication/Credentials
*secret*
*credential*
*.pem
*.key
*.cert

# ==========================================
# 2. NPM & DEPENDENCY RELATED FILES
# ==========================================
# Dependencies are heavy. Instead of pushing them, we push package.json and run 'npm install'
node_modules/
frontend/node_modules/
.npm/

# npm and yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# 3. DATABASE FILES
# ==========================================
# Local database files shouldn't be shared
*.sqlite
*.sqlite3
*.db
*.db3
*.sqlitedb
*.mdb

# ==========================================
# 4. BUILD OUTPUTS & CACHES
# ==========================================
# Compiled output (Vite/React build files)
dist/
dist-ssr/
build/
.next/
out/

# Caches
.eslintcache
.stylelintcache
.vite/

# ==========================================
# 5. OS & EDITOR SPECIFIC FILES
# ==========================================
# Mac / Windows system files
.DS_Store
Thumbs.db

# VS Code, IntelliJ, etc.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
